# ─────────────────────────────────────────────────────────────────────────────
# Cafe Niloufer – Environment Variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── DeepSeek AI assistant (optional – see README for deployment modes) ────────
#
# Your DeepSeek API key. Obtain one at https://platform.deepseek.com/
# If this is left blank, the kiosk automatically uses the local fallback parser
# and voice ordering still works – just without AI-powered natural language.
#
DEEPSEEK_API_KEY=

# DeepSeek model to use. Defaults to "deepseek-chat" if not set.
# DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API base URL. Defaults to https://api.deepseek.com/chat/completions
# Override for a self-hosted or proxy endpoint.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Timeout in milliseconds for DeepSeek API calls. Defaults to 8000 (8 s).
# The kiosk falls back to local parsing if DeepSeek does not respond in time.
# DEEPSEEK_TIMEOUT_MS=8000
